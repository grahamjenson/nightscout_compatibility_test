#####
# Alexa (alexa plugin): the intents and metrics the other plugins register
#####

NAME plugins_alexa_launch
POST http://{{ .site }}/api/v1/alexa?token={{ token }}
B {"version": "1.0", "session": {"new": true}, "request": {"type": "LaunchRequest", "locale": "en-US"}}

NAME plugins_alexa_status
POST http://{{ .site }}/api/v1/alexa?token={{ token }}
B {"version": "1.0", "session": {"new": true}, "request": {"type": "IntentRequest", "locale": "en-US", "intent": {"name": "NSStatus"}}}

NAME plugins_alexa_metric_bg
POST http://{{ .site }}/api/v1/alexa?token={{ token }}
B {"version": "1.0", "session": {"new": true}, "request": {"type": "IntentRequest", "locale": "en-US", "intent": {"name": "MetricNow", "slots": {"metric": {"name": "metric", "resolutions": {"resolutionsPerAuthority": [{"status": {"code": "ER_SUCCESS_MATCH"}, "values": [{"value": {"name": "bg"}}]}]}}}}}}

NAME plugins_alexa_metric_delta
POST http://{{ .site }}/api/v1/alexa?token={{ token }}
B {"version": "1.0", "session": {"new": true}, "request": {"type": "IntentRequest", "locale": "en-US", "intent": {"name": "MetricNow", "slots": {"metric": {"name": "metric", "resolutions": {"resolutionsPerAuthority": [{"status": {"code": "ER_SUCCESS_MATCH"}, "values": [{"value": {"name": "delta"}}]}]}}}}}}

