#####
# Nightscout plugins, through the API they show up in:
# /api/v2/properties/<plugin> and the Alexa / Google Home virtual assistants.
# Plugins only read the data Nightscout has loaded, so this file creates its own data at the current time,
# waits for the reload, then deletes it again at the end.
#####

NAME plugins_create_profile
POST http://{{ .site }}/api/v1/profile?token={{ token }}
B {
    "defaultProfile": "Plugins",
    "startDate": "{{ time 1440 }}",
    "created_at": "{{ time 1440 }}",
    "units": "mg/dl",
    "store": {
      "Plugins": {
        "dia": 3,
        "carbs_hr": 20,
        "delay": 20,
        "timezone": "UTC",
        "units": "mg/dl",
        "carbratio": [{"time": "00:00", "value": 10, "timeAsSeconds": 0}],
        "sens": [{"time": "00:00", "value": 50, "timeAsSeconds": 0}],
        "basal": [{"time": "00:00", "value": 1.0, "timeAsSeconds": 0}],
        "target_low": [{"time": "00:00", "value": 100, "timeAsSeconds": 0}],
        "target_high": [{"time": "00:00", "value": 120, "timeAsSeconds": 0}]
      }
    }
  }

# bgnow, delta, direction, ar2 and rawbg (which needs a calibration and filtered/unfiltered values)
NAME plugins_create_entries
POST http://{{ .site }}/api/v1/entries?token={{ token }}
B [
    {"type": "cal", "date": {{ itime 60 }}, "slope": 1000, "intercept": 30000, "scale": 1, "device": "plugin-test"},
    {"type": "sgv", "sgv": 100, "date": {{ itime 20 }}, "dateString": "{{ time 20 }}", "direction": "FortyFiveUp", "filtered": 130000, "unfiltered": 130000, "noise": 1, "device": "plugin-test"},
    {"type": "sgv", "sgv": 110, "date": {{ itime 15 }}, "dateString": "{{ time 15 }}", "direction": "FortyFiveUp", "filtered": 140000, "unfiltered": 140000, "noise": 1, "device": "plugin-test"},
    {"type": "sgv", "sgv": 120, "date": {{ itime 10 }}, "dateString": "{{ time 10 }}", "direction": "FortyFiveUp", "filtered": 150000, "unfiltered": 150000, "noise": 1, "device": "plugin-test"},
    {"type": "sgv", "sgv": 130, "date": {{ itime 5 }}, "dateString": "{{ time 5 }}", "direction": "FortyFiveUp", "filtered": 160000, "unfiltered": 160000, "noise": 1, "device": "plugin-test"},
    {"type": "sgv", "sgv": 140, "date": {{ itime 0 }}, "dateString": "{{ time 0 }}", "direction": "FortyFiveUp", "filtered": 170000, "unfiltered": 170000, "noise": 1, "device": "plugin-test"}
  ]

# iob, cob, bwp, basal (temp basal) and the sage, cage, iage and bage device ages
NAME plugins_create_treatments
POST http://{{ .site }}/api/v1/treatments?token={{ token }}
B [
    {"eventType": "Correction Bolus", "insulin": 2, "created_at": "{{ time 10 }}", "enteredBy": "plugin-test"},
    {"eventType": "Meal Bolus", "carbs": 30, "insulin": 3, "created_at": "{{ time 10 }}", "enteredBy": "plugin-test"},
    {"eventType": "Temp Basal", "rate": 0.5, "absolute": 0.5, "duration": 30, "created_at": "{{ time 5 }}", "enteredBy": "plugin-test"},
    {"eventType": "Sensor Start", "created_at": "{{ time 2880 }}", "enteredBy": "plugin-test"},
    {"eventType": "Site Change", "created_at": "{{ time 1440 }}", "enteredBy": "plugin-test"},
    {"eventType": "Insulin Change", "created_at": "{{ time 4320 }}", "enteredBy": "plugin-test"},
    {"eventType": "Pump Battery Change", "created_at": "{{ time 5040 }}", "enteredBy": "plugin-test"}
  ]

# pump, upbat, openaps, loop and xdripjs (sensorState)
NAME plugins_create_devicestatus
POST http://{{ .site }}/api/v1/devicestatus?token={{ token }}
B [
    {
      "device": "openaps://plugin-test",
      "created_at": "{{ time 1 }}",
      "uploader": {"battery": 55},
      "pump": {"clock": "{{ time 1 }}", "reservoir": 150.5, "battery": {"percent": 75, "voltage": 1.4}, "status": {"status": "normal", "bolusing": false, "suspended": false}},
      "openaps": {
        "iob": {"iob": 1.5, "basaliob": 0.5, "timestamp": "{{ time 1 }}"},
        "suggested": {"bg": 140, "temp": "absolute", "rate": 0.5, "duration": 30, "reason": "plugin test", "eventualBG": 120, "COB": 20, "IOB": 1.5, "timestamp": "{{ time 1 }}"},
        "enacted": {"bg": 140, "temp": "absolute", "rate": 0.5, "duration": 30, "reason": "plugin test", "received": true, "timestamp": "{{ time 1 }}"}
      }
    },
    {
      "device": "loop://plugin-test",
      "created_at": "{{ time 2 }}",
      "loop": {
        "name": "Loop", "version": "3.4", "timestamp": "{{ time 2 }}",
        "iob": {"iob": 1.2, "timestamp": "{{ time 2 }}"},
        "cob": {"cob": 15, "timestamp": "{{ time 2 }}"},
        "predicted": {"startDate": "{{ time 2 }}", "values": [140, 138, 135, 130]},
        "enacted": {"rate": 0.5, "duration": 30, "received": true, "timestamp": "{{ time 2 }}"},
        "recommendedBolus": 0.2
      }
    },
    {
      "device": "xdripjs://plugin-test",
      "created_at": "{{ time 3 }}",
      "xdripjs": {
        "state": 6, "stateString": "OK", "stateStringShort": "OK", "txId": "8XXXXX", "txStatus": 0, "txStatusString": "OK", "txStatusStringShort": "OK",
        "txActivation": {{ itime 7200 }}, "mode": "expired", "timestamp": {{ itime 3 }}, "rssi": -80,
        "unfiltered": 170000, "filtered": 170000, "noise": 1, "noiseString": "Clean", "slope": 1000, "intercept": 30000, "calType": "LeastSquaresRegression",
        "lastCalibrationDate": {{ itime 720 }}, "sessionStart": {{ itime 2880 }}, "batteryTimestamp": {{ itime 60 }}, "voltagea": 310, "voltageb": 300, "temperature": 32, "resistance": 1000
      }
    }
  ]

# Nightscout reloads its data in the background, within 5s of a write
NAME plugins_wait_for_reload
SET {{ sleep "7s" }}

