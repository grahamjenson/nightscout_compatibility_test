POST http://{{ .site }}/api/v1/alexa?token={{ token }}
B {"version": "1.0", "session": {"new": true}, "request": {"type": "IntentRequest", "locale": "en-US", "intent": {"name": "MetricNow", "slots": {"metric": {"name": "metric", "resolutions": {"resolutionsPerAuthority": [{"status": {"code": "ER_SUCCESS_MATCH"}, "values": [{"value": {"name": "iob"}}]}]}}}}}}

