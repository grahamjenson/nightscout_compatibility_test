#####
# Google Home (googlehome plugin)
#####

NAME plugins_googlehome_status
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "NSStatus"}, "parameters": {}, "languageCode": "en"}}

NAME plugins_googlehome_metric_bg
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "bg"}, "languageCode": "en"}}

NAME plugins_googlehome_metric_iob
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "iob"}, "languageCode": "en"}}

NAME plugins_googlehome_metric_cob
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "cob"}, "languageCode": "en"}}

NAME plugins_googlehome_metric_basal
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "basal"}, "languageCode": "en"}}

NAME plugins_googlehome_metric_pump_battery
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "pump battery"}, "languageCode": "en"}}

NAME plugins_googlehome_metric_cgm_session_age
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "cgm session age"}, "languageCode": "en"}}

NAME plugins_googlehome_uploader_battery
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "UploaderBattery"}, "parameters": {}, "languageCode": "en"}}

NAME plugins_googlehome_last_loop
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "LastLoop"}, "parameters": {}, "languageCode": "en"}}

NAME plugins_googlehome_unknown_metric
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "MetricNow"}, "parameters": {"metric": "not a metric"}, "languageCode": "en"}}

NAME plugins_googlehome_unknown_intent
POST http://{{ .site }}/api/v1/googlehome?token={{ token }}
B {"queryResult": {"intent": {"displayName": "NotAnIntent"}, "parameters": {}, "languageCode": "en"}}

NAME plugins_googlehome_read_token
POST http://{{ .site }}/api/v1/googlehome?token={{ read_token }}
B {"queryResult": {"intent": {"displayName": "NSStatus"}, "parameters": {}, "languageCode": "en"}}

#####
# Clean up so later files see the data they expect
#####

# the calibration is deleted with the readings
NAME plugins_delete_entries
DELETE http://{{ .site }}/api/v1/entries?token={{ token }}&find[device]=plugin-test

NAME plugins_delete_treatments
DELETE http://{{ .site }}/api/v1/treatments?token={{ token }}&find[enteredBy]=plugin-test

NAME plugins_delete_openaps_devicestatus
DELETE http://{{ .site }}/api/v1/devicestatus/{{ dig "plugins_create_devicestatus.0._id" }}?token={{ token }}

NAME plugins_delete_loop_devicestatus
DELETE http://{{ .site }}/api/v1/devicestatus/{{ dig "plugins_create_devicestatus.1._id" }}?token={{ token }}

NAME plugins_delete_xdripjs_devicestatus
DELETE http://{{ .site }}/api/v1/devicestatus/{{ dig "plugins_create_devicestatus.2._id" }}?token={{ token }}

NAME plugins_delete_profile
DELETE http://{{ .site }}/api/v1/profile/{{ dig "plugins_create_profile.0._id" }}?token={{ token }}
