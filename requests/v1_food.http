#####
# CREATE
#####

NAME create_food_v1
POST http://{{ .site }}/api/v1/food?token={{ token }}
B { "name": "Banana", "category": "Snacks", "subcategory": "Fruit", "portion": 1, "unit": "serving", "carbs": 27, "fat": 0.3, "protein": 1.3, "energy": 105, "gi": 51 }

NAME create_foods_v1
POST http://{{ .site }}/api/v1/food?token={{ token }}
B [{ "name": "Banana2", "category": "Snacks", "carbs": 27 },{ "name": "Banana3", "category": "Snacks", "carbs": 27 } ]

#####
# READ 
#####

NAME get_foodes_find_device_v1
GET http://{{ .site }}/api/v1/food?token={{ token }}&find[device]=aaps

NAME get_foodes_find_id_v1
GET http://{{ .site }}/api/v1/food?token={{ token }}&find[_id]={{ dig "create_food_v1.0._id"  }}

NAME get_foodes_v1
GET http://{{ .site }}/api/v1/food?token={{ token }}

####
# UPDATE
####

#####
# DELETE/CLEAN UP
#####

NAME delete_food_v1
DELETE http://{{ .site }}/api/v1/food/{{ dig "create_food_v1.0._id" }}?token={{ token }}


#####
# MORE ENDPOINTS
#####

NAME create_quickpick_food_v1
POST http://{{ .site }}/api/v1/food?token={{ token }}
B {"type": "quickpick", "name": "Breakfast", "foods": [{"name": "Toast", "carbs": 15, "portions": 2}], "carbs": 30, "hideafteruse": "true", "hidden": "false", "position": 1}

NAME get_food_quickpicks_v1
GET http://{{ .site }}/api/v1/food/quickpicks?token={{ token }}

NAME create_regular_food_v1
POST http://{{ .site }}/api/v1/food?token={{ token }}
B {"type": "food", "name": "Apple", "category": "Fruit", "subcategory": "Fresh", "portion": 1, "unit": "pcs", "carbs": 20, "gi": 2}

NAME get_food_regular_v1
GET http://{{ .site }}/api/v1/food/regular?token={{ token }}

NAME update_food_v1
PUT http://{{ .site }}/api/v1/food?token={{ token }}
B {"_id": "{{ dig "create_regular_food_v1.0._id" }}", "type": "food", "name": "Green Apple", "category": "Fruit", "subcategory": "Fresh", "portion": 1, "unit": "pcs", "carbs": 18, "gi": 2}

NAME get_food_after_update_v1
GET http://{{ .site }}/api/v1/food?token={{ token }}&find[_id]={{ dig "create_regular_food_v1.0._id" }}

NAME delete_quickpick_food_v1
DELETE http://{{ .site }}/api/v1/food/{{ dig "create_quickpick_food_v1.0._id" }}?token={{ token }}

NAME delete_regular_food_v1
DELETE http://{{ .site }}/api/v1/food/{{ dig "create_regular_food_v1.0._id" }}?token={{ token }}
