#####
# CREATE
#####

NAME create_profile_v1
POST http://{{ .site }}/api/v1/profile?token={{ token }}
B {
  "defaultProfile": "profile_1",

  "store": {
    "profile_1": {
      "dia": 6,

      "carbratio": [
        { "time": "00:00", "value": 12 },
        { "time": "06:00", "value": 10 },
        { "time": "12:00", "value": 11 },
        { "time": "18:00", "value": 13 }
      ],

      "sens": [
        { "time": "00:00", "value": 2.5 },
        { "time": "06:00", "value": 2.2 },
        { "time": "12:00", "value": 2.0 },
        { "time": "18:00", "value": 2.3 }
      ],

      "basal": [
        { "time": "00:00", "value": 0.9 },
        { "time": "03:00", "value": 0.85 },
        { "time": "06:00", "value": 0.8 },
        { "time": "12:00", "value": 0.75 },
        { "time": "18:00", "value": 0.85 }
      ],

      "target_low": [
        { "time": "00:00", "value": 5 },
        { "time": "06:00", "value": 4.7 },
        { "time": "12:00", "value": 5 },
        { "time": "18:00", "value": 5.3 }
      ],

      "target_high": [
        { "time": "00:00", "value": 6.1 },
        { "time": "06:00", "value": 5.8 },
        { "time": "12:00", "value": 6.1 },
        { "time": "18:00", "value": 6.7 }
      ],

      "timezone": "Pacific/Auckland",
      "units": "mmol"
    }
  },

  "startDate": "{{ time 1 }}",
  "mills": {{ itime 0 }}
 }

NAME create_profiles_v1
POST http://{{ .site }}/api/v1/profile?token={{ token }}
B [{ "defaultProfile": "profile_2", "store": { "profile_2": { "dia": 7 } } }, { "defaultProfile": "profile_3", "store": { "profile_3": { "dia": 8 } }}] 

NAME create_profile_again_v1
POST http://{{ .site }}/api/v1/profile?token={{ token }}
B {
    "units": "mg/dl",
    "startDate": "2017-07-02T00:22:00.000Z",
    "defaultProfile": "Default",
    "store": {
        "Default": {
            "dia": "5",
            "units": "mg/dl",
            "sens": [{"value": "110", "time": "00:00", "timeAsSeconds": "0"}],
            "target_low": [{"value": "100", "time": "00:00", "timeAsSeconds": "0"}],
            "target_high": [{"value": "100", "time": "00:00", "timeAsSeconds": "0"}],
            "carbratio": [{"value": "33", "time": "00:00", "timeAsSeconds": "0"}],
            "basal": [
                {"value": "0.35", "time": "00:00", "timeAsSeconds": "0"},
                {"value": "0.35", "time": "03:00", "timeAsSeconds": "10800"},
                {"value": "0.35", "time": "05:00", "timeAsSeconds": "18000"},
                {"value": "0.3", "time": "07:00", "timeAsSeconds": "25200"},
                {"value": "0.45", "time": "17:00", "timeAsSeconds": "61200"},
                {"value": "0.35", "time": "19:00", "timeAsSeconds": "68400"}
            ],
            "carbs_hr": "20",
            "delay": "20",
            "timezone": "US/Eastern",
            "startDate": "1970-01-01T00:00:00.000Z"
        }
    },
    "mills": "1498954920000",
    "created_at": "2017-07-02T00:25:33.154Z"
    }

