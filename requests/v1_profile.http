#####
# READ 
#####

NAME get_profilees_find_device_v1
GET http://{{ .site }}/api/v1/profile?token={{ token }}&find[defaultProfile]=profile_1

NAME get_profilees_find_id_v1
GET http://{{ .site }}/api/v1/profile?token={{ token }}&find[_id]={{ dig "create_profile_v1.0._id"  }}

NAME get_profilees_v1
GET http://{{ .site }}/api/v1/profile?token={{ token }}

NAME get_current_profile_v1
GET http://{{ .site }}/api/v1/profile/current?token={{ token }}

####
# UPDATE
####


#####
# DELETE/CLEAN UP
#####

NAME delete_profile_v1
DELETE http://{{ .site }}/api/v1/profile/{{ dig "get_current_profile_v1._id" }}?token={{ token }}

NAME delete_current_profile_v1
GET http://{{ .site }}/api/v1/profile/current?token={{ token }}
