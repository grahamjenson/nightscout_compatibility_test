#####
# READ 
#####



NAME get_treatmentses_find_device_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[defaultProfile]=treatments_1

NAME get_treatmentses_find_id_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[_id]={{ dig "create_treatments_v1.0._id"  }}

NAME get_treatmentses_find_type_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[eventType]=Meal%20Bolus

NAME get_treatmentses_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}


####
# UPDATE
####

NAME get_treatments_before_update_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[_id]={{ dig "create_treatments_v1.0._id"  }}

NAME update_put_root_treatments_v1
PUT http://{{ .site }}/api/v1/treatments?token={{ token }}
B {"_id": "{{ dig "create_treatments_v1.0._id" }}", "eventType": "Meal Bolus", "created_at": "{{ time 0 }}", "notes": "updated by update_put_root_treatments_v1", "carbs": 1}

NAME get_treatments_after_put_root_update_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[_id]={{ dig "create_treatments_v1.0._id"  }}

NAME update_put_root_treatments_noid_v1
PUT http://{{ .site }}/api/v1/treatments?token={{ token }}
B {"_id": "treatmentv1t1", "eventType": "Meal Bolus", "created_at": "{{ time 0 }}", "notes": "updated by update_put_root_treatments_noid_v1", "carbs": 1}

NAME get_treatments_after_put_root_noid_update_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[_id]={{ dig "update_put_root_treatments_noid_v1._id"  }}

NAME get_treatments_v3_with_self_identifier_v1
GET http://{{ .site }}/api/v3/treatments/treatmentv1t1
H Authorization: Bearer {{ jwt }}



#####
# DELETE/CLEAN UP
#####

NAME delete_treatments_v1
DELETE http://{{ .site }}/api/v1/treatments/{{ dig "create_treatments_v1.0._id" }}?token={{ token }}

NAME delete_treatments_noid_v1
DELETE http://{{ .site }}/api/v1/treatments/treatmentfdsfdsf?token={{ token }}

NAME get_treatments_after_delete_v1
GET http://{{ .site }}/api/v1/treatments?token={{ token }}&find[_id]={{ dig "create_treatments_v1.0._id"  }}

