#####
# CREATE
#####

NAME create_treatments_v1
POST http://{{ .site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Meal Bolus",
  "created_at": "{{ time 0 }}",

  "glucose": 148,
  "glucoseType": "Sensor",

  "carbs": 45,
  "insulin": 4.2,

  "duration": 0,

  "notes": "Lunch pasta + insulin pre-bolus",
  "enteredBy": "aaps-loop",

  "treatments": "treatments_1",
  "percentage": 10,
  "absolute": null,

  "reason": "lunch",
  "targetTop": 110,
  "targetBottom": 85
 }


