#####
# CREATE
#####

NAME create_treatments_v3
POST http://{{ .site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
  "app": "asd",
  "eventType": "Meal Bolus",
  "created_at": "{{ .time_0 }}",

  "glucose": 148,
  "glucoseType": "Sensor",

  "carbs": 45,
  "insulin": 4.2,

  "duration": 0,

  "notes": "Lunch pasta + insulin pre-bolus",
  "enteredBy": "aaps-loop",

  "treatments": "treatments_1",
  "percentage": 10,
  "absolute": null,

  "reason": "lunch",
  "targetTop": 110,
  "targetBottom": 85
 }


NAME create_put_treatments_v3
PUT http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier"  }}custom
H Authorization: Bearer {{ jwt }}
B {
  "app": "asd",
  "eventType": "Temp Basal",
  "created_at": "{{ time 0 }}",

  "glucose": 148,
  "glucoseType": "Sensor",

  "carbs": 45,
  "insulin": 4.2,

  "duration": 0,

  "notes": "Lunch pasta + insulin pre-bolus",
  "enteredBy": "aaps-loop",

  "treatments": "treatments_1",
  "percentage": 10,
  "absolute": null,

  "reason": "lunch",
  "targetTop": 110,
  "targetBottom": 85
 }

