#####
# READ 
#####

NAME get_treatments_v3
GET http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier"  }}
H Authorization: Bearer {{ jwt }}

NAME get_treatments_v3_with_fields
GET http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier"  }}?fields=date,sgv,notes
H Authorization: Bearer {{ jwt }}

NAME get_treatmentss_v3
GET http://{{ .site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}

NAME get_history_treatments_v3
GET http://{{ .site }}/api/v3/treatments/history/{{ itime 30}}
H Authorization: Bearer {{ jwt }}

NAME get_treatments_limit_v3
GET http://{{ .site }}/api/v3/treatments?limit=1
H Authorization: Bearer {{ jwt }}

NAME get_treatments_skip_v3
GET http://{{ .site }}/api/v3/treatments?skip=1
H Authorization: Bearer {{ jwt }}

NAME get_treatments_sort_date_v3
GET http://{{ .site }}/api/v3/treatments?sort=date
H Authorization: Bearer {{ jwt }}

NAME get_treatments_sort_date_desc_v3
GET http://{{ .site }}/api/v3/treatments?sort$desc=date
H Authorization: Bearer {{ jwt }}

NAME get_treatments_fields_v3
GET http://{{ .site }}/api/v3/treatments?fields=date,sgv,notes
H Authorization: Bearer {{ jwt }}

NAME get_treatments_type_eq_v3
GET http://{{ .site }}/api/v3/treatments?type$eq=sgv
H Authorization: Bearer {{ jwt }}

NAME get_treatments_type_ne_v3
GET http://{{ .site }}/api/v3/treatments?type$ne=sgv
H Authorization: Bearer {{ jwt }}

NAME get_treatments_sgv_gt_v3
GET http://{{ .site }}/api/v3/treatments?sgv$gt=115
H Authorization: Bearer {{ jwt }}

NAME get_treatments_sgv_lt_v3
GET http://{{ .site }}/api/v3/treatments?sgv$lt=120
H Authorization: Bearer {{ jwt }}

NAME get_treatments_sgv_lte_v3
GET http://{{ .site }}/api/v3/treatments?sgv$lte=120
H Authorization: Bearer {{ jwt }}

NAME get_treatments_type_in_v3
GET http://{{ .site }}/api/v3/treatments?eventType$in=Temp%20Basal|Temporary%20Target
H Authorization: Bearer {{ jwt }}

NAME get_treatments_type_nin_v3
GET http://{{ .site }}/api/v3/treatments?eventType$nin=Temp%20Basal|Temporary%20Target
H Authorization: Bearer {{ jwt }}

NAME get_treatments_re_v3
GET http://{{ .site }}/api/v3/treatments?direction$re=Flat|Up
H Authorization: Bearer {{ jwt }}

NAME get_treatments_multi_query_v3
GET http://{{ .site }}/api/v3/treatments?type$eq=Temp%20Basal
H Authorization: Bearer {{ jwt }}

NAME get_treatments_multi_query_in_v3
GET http://{{ .site }}/api/v3/treatments?limit=5&skip=2&sort$desc=date&type$eq=Temp%20Basal&fields=date,sgv
H Authorization: Bearer {{ jwt }}

####
# UPDATE
####

NAME get_treatments_before_update_v3
GET http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier"  }}
H Authorization: Bearer {{ jwt }}

NAME update_put_treatments_v3
PUT http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier" }}
B { "app": "asd", "eventType": "Meal Bolus", "created_at": "{{  .time_0 }}",  "notes": "updated by update_put_treatments_v3", "insulin": 1}
H Authorization: Bearer {{ jwt }}

NAME get_treatments_after_put_update_v3
GET http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier"  }}
H Authorization: Bearer {{ jwt }}

NAME update_patch_treatments_v3
PATCH http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier" }}
B { "app": "asd", "eventType": "Meal Bolus", "created_at": "{{ .time_0 }}",  "notes": "updated by update_patch_treatments_v3", "glucose": 1}
H Authorization: Bearer {{ jwt }}

NAME get_treatments_after_patch_update_v3
GET http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier"  }}
H Authorization: Bearer {{ jwt }}

NAME update_put_treatments_noid_v3
PUT http://{{ .site }}/api/v3/treatments/treatmentv3t1
B { "app": "asd", "eventType": "Meal Bolus", "created_at": "{{ time 0 }}",  "notes": "updated by update_put_treatments_v3", "insulin": 1}
H Authorization: Bearer {{ jwt }}

NAME get_treatments_after_put_noid_update_v3
GET http://{{ .site }}/api/v3/treatments/{{ dig "update_put_treatments_noid_v3.identifier" }}
H Authorization: Bearer {{ jwt }}

NAME update_patch_treatments_noid_v3
PATCH http://{{ .site }}/api/v3/treatments/treatmentv3t2
B { "app": "asd", "eventType": "Meal Bolus", "created_at": "{{ time 0 }}",  "notes": "updated by update_patch_treatments_v3", "glucose": 1}
H Authorization: Bearer {{ jwt }}

NAME get_treatments_after_patch_update_noid_v3
GET http://{{ .site }}/api/v3/treatments/{{ dig "update_patch_treatments_noid_v3.identifier" }}
H Authorization: Bearer {{ jwt }}



#####
# DELETE/CLEAN UP
#####

NAME delete_treatments_v3
DELETE http://{{ .site }}/api/v3/treatments/{{ dig "create_treatments_v3.identifier" }}
H Authorization: Bearer {{ jwt }}

NAME delete_treatments2_v3
DELETE http://{{ .site }}/api/v3/treatments/{{ dig "create_put_treatments_v3.identifier" }}
H Authorization: Bearer {{ jwt }}
