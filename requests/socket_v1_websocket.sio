#####
# Nightscout's original websocket API, on the default "/" namespace.
# The Nightscout web client and many follower apps use this.
#####

NAME ws_connect
CONNECT http://{{ .site }}/

# authorize acks with the client's permissions,
# then emits "connected" and a full "dataUpdate" if the client can read
NAME ws_authorize
EMIT authorize
B {"client": "web", "token": "{{ jwt }}", "history": 1}
ACK

NAME ws_connected
WAIT connected

NAME ws_initial_data_update
WAIT dataUpdate

NAME ws_load_retro
EMIT loadRetro
B {}
ACK

NAME ws_retro_update
WAIT retroUpdate

#####
# Data created through the REST API is pushed to readers as a delta "dataUpdate"
#####

NAME ws_create_entry_v1
POST http://{{ .site }}/api/v1/entries?token={{ token }}
B [{"type": "sgv", "sgv": 123, "date": {{ itime 0 }}, "device": "socket-test"}]

NAME ws_data_update_after_create_entry
WAIT dataUpdate
T 30s

#####
# Clients with write permission can change data over the websocket
#####

NAME ws_db_add_treatment
EMIT dbAdd
B {"collection": "treatments", "data": {"eventType": "Note", "notes": "added over socket.io", "created_at": "{{ time 0 }}", "enteredBy": "socket-test"}}
ACK

NAME ws_data_update_after_db_add
WAIT dataUpdate
T 30s

NAME ws_db_update_treatment
EMIT dbUpdate
B {"collection": "treatments", "_id": "{{ dig "ws_db_add_treatment.0._id" }}", "data": {"notes": "updated over socket.io"}}
ACK

NAME ws_data_update_after_db_update
WAIT dataUpdate
T 30s

NAME ws_db_remove_treatment
EMIT dbRemove
B {"collection": "treatments", "_id": "{{ dig "ws_db_add_treatment.0._id" }}"}
ACK

NAME ws_data_update_after_db_remove
WAIT dataUpdate
T 30s

NAME ws_disconnect
DISCONNECT

#####
# A second connection with a read only token
#####

NAME ws_read_connect
CONNECT http://{{ .site }}/

NAME ws_read_authorize
EMIT authorize
B {"client": "web", "token": "{{ read_jwt }}", "history": 1}
ACK

# writes are refused without write permission
NAME ws_read_db_add_treatment
EMIT dbAdd
B {"collection": "treatments", "data": {"eventType": "Note", "notes": "should not be added", "created_at": "{{ time 0 }}"}}
ACK

NAME ws_read_disconnect
DISCONNECT


#####
# dbUpdateUnset removes fields from a document
#####

NAME ws_unset_connect
CONNECT http://{{ .site }}/

NAME ws_unset_authorize
EMIT authorize
B {"client": "web", "token": "{{ jwt }}", "history": 1}
ACK

NAME ws_unset_db_add_treatment
EMIT dbAdd
B {"collection": "treatments", "data": {"eventType": "Note", "notes": "unset over socket.io", "carbs": 5, "created_at": "{{ time 0 }}", "enteredBy": "socket-test-unset"}}
ACK

NAME ws_db_update_unset_treatment
EMIT dbUpdateUnset
B {"collection": "treatments", "_id": "{{ dig "ws_unset_db_add_treatment.0._id" }}", "data": {"carbs": 1}}
ACK

NAME ws_get_treatment_after_unset
GET http://{{ .site }}/api/v1/treatments.json?token={{ token }}&find[_id]={{ dig "ws_unset_db_add_treatment.0._id" }}

NAME ws_db_remove_unset_treatment
EMIT dbRemove
B {"collection": "treatments", "_id": "{{ dig "ws_unset_db_add_treatment.0._id" }}"}
ACK

# Unknown collections and missing ids are rejected
NAME ws_db_add_unknown_collection
EMIT dbAdd
B {"collection": "notacollection", "data": {"a": 1}}
ACK

NAME ws_db_remove_missing_id
EMIT dbRemove
B {"collection": "treatments"}
ACK

NAME ws_unset_disconnect
DISCONNECT


#####
# Every client on "/" is told how many clients are connected
#####

NAME ws_clients_connect
CONNECT http://{{ .site }}/

NAME ws_clients_count
WAIT clients

NAME ws_clients_second_connect
CONNECT http://{{ .site }}/

NAME ws_clients_count_after_second_connect
WAIT clients
C ws_clients_connect

NAME ws_clients_second_disconnect
DISCONNECT
C ws_clients_second_connect

NAME ws_clients_count_after_second_disconnect
WAIT clients
C ws_clients_connect

#####
# authorize with status adds the server status to the first dataUpdate
#####

NAME ws_status_authorize
EMIT authorize
C ws_clients_connect
B {"client": "web", "token": "{{ jwt }}", "history": 1, "status": true}
ACK

NAME ws_status_data_update
WAIT dataUpdate
C ws_clients_connect

#####
# dbAdd, dbUpdate and dbRemove work on every supported collection
#####

NAME ws_db_add_devicestatus
EMIT dbAdd
C ws_clients_connect
B {"collection": "devicestatus", "data": {"device": "socket-test", "created_at": "{{ time 0 }}", "uploader": {"battery": 42}}}
ACK

NAME ws_db_update_devicestatus
EMIT dbUpdate
C ws_clients_connect
B {"collection": "devicestatus", "_id": "{{ dig "ws_db_add_devicestatus.0._id" }}", "data": {"uploader": {"battery": 41}}}
ACK

NAME ws_db_remove_devicestatus
EMIT dbRemove
C ws_clients_connect
B {"collection": "devicestatus", "_id": "{{ dig "ws_db_add_devicestatus.0._id" }}"}
ACK

NAME ws_db_add_entry
EMIT dbAdd
C ws_clients_connect
B {"collection": "entries", "data": {"type": "sgv", "sgv": 120, "date": {{ itime 0 }}, "device": "socket-test"}}
ACK

NAME ws_db_remove_entry
EMIT dbRemove
C ws_clients_connect
B {"collection": "entries", "_id": "{{ dig "ws_db_add_entry.0._id" }}"}
ACK

NAME ws_db_add_food
EMIT dbAdd
C ws_clients_connect
B {"collection": "food", "data": {"type": "food", "name": "Socket Apple", "category": "Fruit", "carbs": 20, "portion": 1, "unit": "pcs"}}
ACK

NAME ws_db_update_food
EMIT dbUpdate
C ws_clients_connect
B {"collection": "food", "_id": "{{ dig "ws_db_add_food.0._id" }}", "data": {"carbs": 18}}
ACK

NAME ws_db_remove_food
EMIT dbRemove
C ws_clients_connect
B {"collection": "food", "_id": "{{ dig "ws_db_add_food.0._id" }}"}
ACK

NAME ws_db_add_profile
EMIT dbAdd
C ws_clients_connect
B {"collection": "profile", "data": {"defaultProfile": "Socket", "startDate": "{{ time 30 }}", "units": "mg/dl", "store": {"Socket": {"dia": 5, "carbratio": [{"time": "00:00", "value": 10, "timeAsSeconds": 0}], "sens": [{"time": "00:00", "value": 50, "timeAsSeconds": 0}], "basal": [{"time": "00:00", "value": 0.8, "timeAsSeconds": 0}], "target_low": [{"time": "00:00", "value": 90, "timeAsSeconds": 0}], "target_high": [{"time": "00:00", "value": 120, "timeAsSeconds": 0}], "timezone": "UTC", "units": "mg/dl"}}}}
ACK

NAME ws_db_remove_profile
EMIT dbRemove
C ws_clients_connect
B {"collection": "profile", "_id": "{{ dig "ws_db_add_profile.0._id" }}"}
ACK

NAME ws_db_add_activity
EMIT dbAdd
C ws_clients_connect
B {"collection": "activity", "data": {"activityType": "walking", "created_at": "{{ time 0 }}", "duration": 10, "steps": 500}}
ACK

NAME ws_db_remove_activity
EMIT dbRemove
C ws_clients_connect
B {"collection": "activity", "_id": "{{ dig "ws_db_add_activity.0._id" }}"}
ACK

# Adding the same treatment again finds the first one instead of adding a copy
NAME ws_db_add_treatment_for_dedup
EMIT dbAdd
C ws_clients_connect
B {"collection": "treatments", "data": {"eventType": "Note", "notes": "dedup over socket.io", "created_at": "{{ time 0 }}", "enteredBy": "socket-test-dedup"}}
ACK

NAME ws_db_add_treatment_duplicate
EMIT dbAdd
C ws_clients_connect
B {"collection": "treatments", "data": {"eventType": "Note", "notes": "dedup over socket.io", "created_at": "{{ dig "ws_db_add_treatment_for_dedup.0.created_at" }}", "enteredBy": "socket-test-dedup"}}
ACK

NAME ws_get_treatments_after_dedup
GET http://{{ .site }}/api/v1/treatments.json?token={{ token }}&find[enteredBy]=socket-test-dedup

NAME ws_db_remove_dedup_treatment
EMIT dbRemove
C ws_clients_connect
B {"collection": "treatments", "_id": "{{ dig "ws_db_add_treatment_for_dedup.0._id" }}"}
ACK

NAME ws_clients_disconnect
DISCONNECT
C ws_clients_connect

#####
# A rejected authorize disconnects the client
#####

NAME ws_rejected_connect
CONNECT http://{{ .site }}/

NAME ws_rejected_authorize
EMIT authorize
B {"client": "web", "token": "not-a-real-token", "history": 1}

NAME ws_rejected_disconnected
WAIT disconnect
